# Values for docker-compose.prod.yml. Copy to .env (never commit it).
# The dev setup does not need this file (it uses Server/.env).

# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
# POSTGRES_PASSWORD=postgres
# APP_URL=http://localhost:8080

# Sign in with Google / GitHub (optional). Redirect URI at the provider:
# http://localhost:8080/api/auth/oauth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
