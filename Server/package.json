{
  "name": "ecommerce-rest-api",
  "version": "1.0.0",
  "description": "Feature-based REST API for an eCommerce platform backed by PostgreSQL",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js up",
    "db:rollback": "node src/db/migrate.js down",
    "db:seed": "node src/db/seed.js",
    "db:migration:create": "node-pg-migrate create -m src/db/migrations -j sql",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ecommerce",
    "rest-api",
    "express",
    "postgresql",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "prettier": "3.9.10",
    "supertest": "^7.3.1"
  }
}
