# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
PGHOST=localhost
# 5433 = Docker Compose database (see docker-compose.yml), 5432 = locally installed PostgreSQL
PGPORT=5433
PGDATABASE=ecommerce_db
PGUSER=postgres
PGPASSWORD=postgres

# Alternative single connection string (if using Render/Supabase/Neon)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_db

# Security & Authentication
# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=supersecretjwtkey_change_me_in_production
# Access token (JWT) lifetime; the refresh token renews it
ACCESS_TOKEN_TTL_MINUTES=15
# A session ends after this many days without a refresh
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=10

# Frontend URL: links in emails point there (/verify-email?token=..., /reset-password?token=...)
APP_URL=http://localhost:3000

# Browser origins allowed to call the API with cookies (comma-separated). Default: APP_URL
# CORS_ORIGINS=http://localhost:3000,https://shop.example.com
# Reverse proxies in front of the app (Render, Nginx: 1). 0 = none, X-Forwarded-For is ignored
TRUST_PROXY=0
# Error tracking. Leave empty locally (nothing is sent); production sets it in render.yaml
SENTRY_DSN=
# fatal | error | warn | info | debug | trace | silent (default info, silent under Jest)
LOG_LEVEL=info
# Per-IP request limits (auth endpoints are stricter). Only turn off for tests
RATE_LIMIT_ENABLED=true

# Outgoing email. Defaults = Mailpit from docker-compose.yml (web UI: http://localhost:8025).
# In production: the SMTP data of a mail provider (e.g. Brevo, Postmark, Amazon SES).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ecommerce <no-reply@example.com>"

# Sign in with Google / GitHub (optional; a provider is offered when both values are set).
# Redirect URI to register at the provider: <APP_URL>/api/auth/oauth/<provider>/callback
# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application")
# GitHub: https://github.com/settings/developers (OAuth App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Pricing (amounts in cents; product prices include VAT)
VAT_RATE_PERCENT=19
SHIPPING_FEE_CENTS=499
FREE_SHIPPING_THRESHOLD_CENTS=5000

# Seed data (npm run db:seed, development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
