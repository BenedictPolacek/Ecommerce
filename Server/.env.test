# Test overrides, loaded before .env when NODE_ENV=test (Jest sets it automatically).
# Committed on purpose: only test values, no real secrets.
# Connection settings (host, port, user, password) still come from .env.

# Separate database: integration tests wipe all tables before each test.
# The name must end with "_test", otherwise the test setup refuses to run.
PGDATABASE=ecommerce_db_test

JWT_SECRET=test_only_secret_at_least_32_characters_long

# The suites log in and register far more often than the auth rate limit allows.
# The limiter itself is tested in tests/unit/rateLimit.test.js.
RATE_LIMIT_ENABLED=false
